/* pages/newsDetail/newsDetail.wxss */
.container {
  background-color: #f8f3e9;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.news-header {
  padding: 30rpx;
  background-color: #fff;
}

.news-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.news-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.meta-item {
  display: flex;
  align-items: center;
}

.label {
  color: #666;
}

.value {
  color: #999;
}

.view-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.news-image {
  width: 100%;
  height: 340rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.detail-image {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.image-placeholder {
  font-size: 100rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: bold;
}

.news-content {
  padding: 30rpx;
  background-color: #fff;
  margin-top: 20rpx;
  line-height: 1.6;
  font-size: 30rpx;
  color: #333;
}

.news-content rich-text {
  width: 100%;
}

.share-section {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.share-btn {
  background-color: #B3261E;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  height: 80rpx;
}

.share-icon {
  margin-right: 10rpx;
}

/* 加载中样式 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 24rpx;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid #ddd;
  border-top: 4rpx solid #B3261E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
} 