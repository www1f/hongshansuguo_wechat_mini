page {
  height: 100%;
  background-color: #f8f3e9;
}

.container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-content {
  padding: 0 30px;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40px;
}

.logo-circle {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background-color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15px;
  overflow: hidden;
}

.logo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.logo-text {
  font-size: 22px;
  font-weight: bold;
  color: #c83e3e;
  margin-bottom: 5px;
}

.logo-text-en {
  font-size: 12px;
  color: #666;
}

.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input-group {
  margin-bottom: 30rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.input {
  width: 539rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input::placeholder {
  color: #999;
}

.input-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.input-item input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
  padding: 0 20rpx;
}

.input-item .icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.options {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 30px;
}

.forget {
  font-size: 14px;
  color: #c83e3e;
}

.login-btn {
  width: 100%;
  height: 50px;
  line-height: 50px;
  text-align: center;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  border-radius: 25px;
  margin-bottom: 40px;
  background-color: #c83e3e;
  display: flex;
  align-items: center;
  justify-content: center;
}

 