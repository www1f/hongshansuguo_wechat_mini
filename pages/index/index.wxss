/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8F3E9;
}
.container {
  padding: 0;
}

/* 搜索栏已移除 */

/* 轮播图 */
.swiper {
  width: 100%;
  height: 360rpx;
  margin: 10rpx 0 20rpx;
}

.swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: all 0.3s ease;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 100%);
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}
.banner-title {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.35);
}

.swiper-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  padding: 0 40rpx;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  position: absolute;
  bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 功能导航 */
.function-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
  overflow: hidden;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1 1 0;
  padding: 0;
  box-sizing: border-box;
}

.nav-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12rpx;
  transition: transform 0.2s ease;
  background: linear-gradient(180deg, #FFF7F6 0%, #FFECEA 100%);
  box-shadow: inset 0 2rpx 8rpx rgba(179,38,30,0.06);
}

.nav-icon:active {
  transform: scale(0.95);
}

.nav-icon-img { width: 80rpx; height: 80rpx; }

.nav-text {
  font-size: 28rpx;
  color: #1F2937;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 故事区域 */
.stories-section {
  padding: 20rpx;
  background-color: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
  overflow: hidden;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1F2937;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 0;
  width: 80rpx;
  height: 4rpx;
  background-color: #B3261E;
}

.stories-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 空状态 */
.empty-state {
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6B7280;
}
.empty-illus {
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #FFEDEA, #FFF7F6 60%, #FFFFFF 100%);
  margin-bottom: 24rpx;
}
.empty-title { color: #1F2937; font-size: 30rpx; font-weight: 600; }
.empty-sub { margin-top: 8rpx; font-size: 26rpx; }
.empty-action {
  margin-top: 20rpx;
  padding: 16rpx 28rpx;
  background: linear-gradient(90deg, #B3261E, #8C1C23);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.story-item {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.story-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.story-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.story-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.story-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
  margin-bottom: 10rpx;
}

.story-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-top: 10rpx;
  height: 72rpx; /* 2行文字的高度：24rpx * 1.5 * 2 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
  display: -webkit-box;
}

.more-stories {
  text-align: center;
  padding: 20rpx 0;
  color: #B3261E;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 15rpx;
  position: relative;
}

.more-stories:after {
  content: '';
  position: absolute;
  bottom: 15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(179,38,30,0) 0%, rgba(179,38,30,0.9) 50%, rgba(179,38,30,0) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.more-stories:active:after {
  opacity: 1;
}

/* 骨架屏与闪烁效果 */
.skeleton .story-image { background: #eee; }
.skeleton-line {
  height: 24rpx;
  background: #eee;
  border-radius: 8rpx;
  margin: 10rpx 0;
}
.skeleton-line.short { width: 60%; height: 30rpx; }
.shimmer { background-image: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%); background-size: 200% 100%; animation: shimmer 1.4s infinite linear; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: 0 0; } }

/* 适配不同屏幕大小 */
@media screen and (min-width: 768px) {
  .function-nav {
    padding: 40rpx 30rpx;
  }
  
  .nav-icon {
    width: 150rpx;
    height: 150rpx;
  }
  
  .nav-icon-img { width: 100rpx; height: 100rpx; }
  
  .swiper {
    height: 400rpx;
  }
  
  .story-item {
    padding: 5rpx;
  }
}
