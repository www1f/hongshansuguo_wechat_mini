.container{padding:20rpx;background:#F8F3E9;min-height:100vh;box-sizing:border-box}
.list-card{background:#fff;border-radius:16rpx;box-shadow:0 12rpx 32rpx rgba(0,0,0,0.08);margin:12rpx 0}
.list-item{display:flex;align-items:center;padding:0 24rpx;height:120rpx;border-bottom:1rpx solid #f2f2f2}
.list-item:last-child{border-bottom:none}
.label{width:200rpx;color:#1F2937;font-size:28rpx}
.value{flex:1;text-align:right;color:#6B7280;font-size:28rpx}
.picker-value{color:#1F2937}
.picker-holder{flex:1;display:flex;justify-content:flex-end}
.avatar-small{width:72rpx;height:72rpx;border-radius:12rpx;display:inline-block;vertical-align:middle}
.btn-primary{margin-top:24rpx;background:linear-gradient(90deg,#B3261E,#8C1C23);color:#fff;text-align:center;padding:20rpx;border-radius:999rpx;font-size:28rpx}

/* 通用输入弹层 */
.editor-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:1000}
.editor-panel{width:80%;background:#fff;border-radius:16rpx;padding:20rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,0.15)}
.editor-input{width:100%;height:80rpx;background:#f7f7f9;border-radius:12rpx;padding:0 20rpx;color:#1F2937;font-size:28rpx;box-sizing:border-box}
.editor-actions{display:flex;justify-content:flex-end;margin-top:16rpx}
.btn-cancel{padding:12rpx 20rpx;border-radius:999rpx;background:#f1f2f4;color:#333;margin-right:12rpx}
.btn-confirm{padding:12rpx 20rpx;border-radius:999rpx;background:#B3261E;color:#fff}