<!--pages/activityDetail/activityDetail.wxml-->
<view class="container" wx:if="{{activity}}">
  <navbar title="活动详情" back="{{true}}" customStyle="background-color: #8c1c23;"></navbar>
  
  <!-- 活动标题和封面图 -->
  <view class="activity-header">
    <image class="cover-image" src="{{activity.image}}" mode="aspectFill"></image>
    <view class="activity-title-container">
      <view class="activity-title">{{activity.title}}</view>
      <view class="activity-participants">
        <text>{{activity.participants}}人参与</text>
      </view>
    </view>
  </view>
  
  <!-- 活动信息 -->
  <view class="info-card">
    <view class="info-item">
      <view class="info-label">活动时间</view>
      <view class="info-value">{{activity.date}}</view>
    </view>
    <view class="info-item">
      <view class="info-label">活动地点</view>
      <view class="info-value">{{activity.location}}</view>
    </view>
  </view>
  
  <!-- 活动详情 -->
  <view class="detail-card">
    <view class="section-title">活动详情</view>
    <text class="detail-text">{{activity.content}}</text>
  </view>
  
  <!-- 活动历史 -->
  <view class="history-card" wx:if="{{activity.history}}">
    <view class="section-title">活动历史</view>
    <text class="history-text">{{activity.history}}</text>
  </view>
  
  <!-- 报名按钮 -->
  <view class="action-bar">
    <button class="join-button" bindtap="joinActivity">立即报名</button>
  </view>
</view>

<!-- 加载提示 -->
<view class="loading" wx:else>
  <text>加载中...</text>
</view>

<!-- 添加AI悬浮球 -->
<floating-ai-button position="right-bottom"></floating-ai-button>

<!-- 页面过渡加载动画 -->
<page-transition id="page-transition"></page-transition> 