.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.feedback-form {
    margin-top: 200rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}

.feedback-input {
  width: 100%;
  height: 300rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.uploaded-image {
  width: 200rpx;
  height: 200rpx;
  margin: 10rpx;
  border-radius: 8rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  margin: 10rpx;
  border: 1rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.plus {
  font-size: 60rpx;
  color: #999;
}

.submit-btn {
  margin-top: 40rpx;
  background: #8c1c23;
  color: #fff;
  border-radius: 40rpx;
} 