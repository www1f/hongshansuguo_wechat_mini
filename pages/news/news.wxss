/* pages/news/news.wxss */
.container {
  background-color: #f8f3e9;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.news-scroll {
  width: 100%;
  height: calc(100vh - 90px);
  padding: 30rpx 0;
  box-sizing: border-box;
}

.news-list {
  padding: 0 30rpx;
}

.news-item {
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
}

.news-image {
  width: 100%;
  height: 240rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-placeholder {
  font-size: 72rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: bold;
}

.news-content {
  padding: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.news-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.news-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.news-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.news-source {
  color: #B3261E;
}

.news-views {
  display: flex;
  align-items: center;
}

.view-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

/* 加载中样式 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid #ddd;
  border-top: 4rpx solid #B3261E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 底部提示样式 */
.bottom-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 40rpx;
  color: #999;
  font-size: 24rpx;
}

.bottom-tip .line {
  width: 80rpx;
  height: 1rpx;
  background-color: #ccc;
}

.bottom-tip .text {
  margin: 0 20rpx;
}