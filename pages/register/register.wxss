.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f8f3e9;
}

.register-content {
  padding: 30rpx;
  flex: 1;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.logo-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  background-color: #B3261E;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.logo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.logo-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.logo-text-en {
  font-size: 24rpx;
  color: #666;
}

.register-form {
  width: 100%;
}

.input-group {
  position: relative;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
}

.input {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 45rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.code-btn {
  position: absolute;
  right: 10rpx;
  height: 70rpx;
  background-color: #B3261E;
  color: white;
  font-size: 24rpx;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: none;
}

.code-btn.sent {
  background-color: #ccc;
  color: #666;
}

.policy {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  margin-right: 10rpx;
  position: relative;
}

.checkbox.checked {
  background-color: #B3261E;
  border-color: #B3261E;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 8rpx;
  height: 16rpx;
  border-right: 4rpx solid white;
  border-bottom: 4rpx solid white;
  transform: rotate(45deg);
}

.policy-link {
  color: #B3261E;
  margin: 0 4rpx;
}

.register-btn {
  width: 100%;
  height: 90rpx;
  background-color: #B3261E;
  color: white;
  font-size: 32rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  border: none;
}

.register-btn.disabled {
  background-color: #f0f0f0;
  color: #bbb;
}

.login-link {
  text-align: center;
  font-size: 28rpx;
  color: #B3261E;
  margin-top: 30rpx;
} 