<!-- 悬浮AI助手按钮组件 -->
<view class="floating-ai-container" style="right: {{buttonLeft}}px; bottom: {{buttonBottom}}px;">
  <!-- 悬浮按钮 -->
  <view class="floating-ai-button" 
        catchtouchstart="handleTouchStart"
        catchtouchmove="handleTouchMove"
        catchtouchend="handleTouchEnd">
    <text class="ai-icon">AI</text>
  </view>

  <!-- 对话框 -->
  <view class="ai-dialog {{showDialog ? 'show' : 'hide'}}">
    <view class="dialog-header">
      <text class="dialog-title">AI助手</text>
      <view class="close-button" catchtap="toggleDialog">×</view>
    </view>
    
    <scroll-view class="dialog-content" scroll-y="true" scroll-into-view="msg-{{messages[messages.length-1].id}}" style="position: relative; left: 0rpx; top: 0rpx; width: 600rpx; display: block; box-sizing: border-box">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message-container {{item.role}}" id="msg-{{item.id}}">
          <view class="message {{item.role}}">
            <block wx:if="{{item.thinking}}">
              <text class="thinking-dots">思考中<text class="dot">.</text><text class="dot">.</text><text class="dot">.</text></text>
            </block>
            <block wx:else>{{item.content}}</block>
          </view>
        </view>
      </block>
    </scroll-view>
    
    <view class="dialog-footer">
      <input class="message-input" 
             placeholder="请输入问题..." 
             value="{{inputText}}" 
             bindinput="onInput"
             confirm-type="send"
             bindconfirm="sendMessage" />
      <view class="send-button" catchtap="sendMessage">发送</view>
    </view>
  </view>
</view> 