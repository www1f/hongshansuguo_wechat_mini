/* 悬浮AI按钮组件样式 */

/* 容器定位 */
.floating-ai-container {
  position: fixed;
  z-index: 9999;
}

/* 悬浮按钮样式 */
.floating-ai-button {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c83e3e, #e75f5f);
  box-shadow: 0 4rpx 12rpx rgba(200, 62, 62, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.floating-ai-button:active {
  transform: scale(0.9);
}

.ai-icon {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

/* 对话框样式 */
.ai-dialog {
  position: absolute;
  bottom: 110rpx;
  right: 0;
  width: 600rpx;
  height: 700rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  transform: scale(0.95) translateY(20rpx);
  transform-origin: bottom right;
  pointer-events: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-dialog.show {
  opacity: 1;
  transform: scale(1) translateY(0);
  pointer-events: auto;
}

.ai-dialog.hide {
  opacity: 0;
  transform: scale(0.95) translateY(20rpx);
  pointer-events: none;
}

/* 对话框头部 */
.dialog-header {
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f1f1;
  background-color: #c83e3e;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.close-button {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

/* 对话内容区 */
.dialog-content {
  flex: 1;
  padding: 16rpx;
  overflow-y: auto;
}

.message-container {
  margin-bottom: 20rpx;
  display: flex;
}

.message-container.user {
  justify-content: flex-end;
}

.message {
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  word-break: break-all;
  line-height: 1.5;
}

.message.ai {
  background-color: #f1f1f1;
  color: #333;
  border-radius: 0 18rpx 18rpx 18rpx;
}

.message.user {
  background-color: #c83e3e;
  color: #fff;
  border-radius: 18rpx 0 18rpx 18rpx;
}

/* 思考中动画 */
.thinking-dots {
  color: #666;
}

.dot {
  opacity: 0;
  animation: blink 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  50% { opacity: 1; }
}

/* 底部输入区 */
.dialog-footer {
  padding: 16rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f1f1f1;
}

.message-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
  border-radius: 36rpx;
}

.send-button {
  width: 100rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #c83e3e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  margin-left: 16rpx;
} 